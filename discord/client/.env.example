# === Discord Bot 設定 ===
# 從 https://discord.com/developers/applications 取得（Bot → Reset Token）
DISCORD_BOT_TOKEN=貼上你的_bot_token

# === 模型服務：opencode 專案在 WSL 架設的 vLLM ===
# deploy.ps1 會自動填好這兩個
LLM_BASE_URL=http://127.0.0.1:8000/v1
WSL_DISTRO=Ubuntu
# 留空 = 自動從 WSL 的 ~/vllm-server/vllm.env 讀取（建議）；筆電換金鑰後 bot 也會自動重讀
LLM_API_KEY=
# 單次請求逾時秒數
LLM_TIMEOUT=600

# 系統提示：決定 bot 的個性與語言
SYSTEM_PROMPT=你是大學研究室的 AI 助理，請用台灣繁體中文回答，內容要正確、簡潔、有條理；不確定的事要說不確定。

# 每個頻道記住的對話則數，以及記憶總字數上限
MAX_HISTORY=10
HISTORY_MAX_CHARS=8000

# 產檔時附件 / 被回覆訊息當參考資料，最多讀幾個字
# （vLLM 上下文 32k 時 10000 字夠用；筆電改用 16k 的 small 組合時建議降到 5000）
REF_MAX_CHARS=10000

# 自動把簡體字轉台灣繁體（1=開、0=關）
TO_TRADITIONAL=1

# 只在這個頻道 ID 回應一般聊天（留空=所有頻道都回；被 @提及、私訊、! 指令一定會回）
ALLOWED_CHANNEL_ID=

# === 文件字型 ===
DOC_FONT_EA=標楷體
DOC_FONT_LATIN=Times New Roman
PPT_FONT=微軟正黑體

# === 聯網搜尋設定 ===
# 用哪個搜尋引擎：google 或 duckduckgo
# 選 google 但沒填下面金鑰時，會自動退回 duckduckgo
SEARCH_ENGINE=google
# Google Custom Search JSON API（免費 100 次/天）
#   API Key：https://console.cloud.google.com/  啟用 "Custom Search API" 後建立金鑰
#   CSE ID ：https://programmablesearchengine.google.com/  建立搜尋引擎，設「搜尋整個網路」
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
