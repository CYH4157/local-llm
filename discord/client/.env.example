# === Discord Bot 設定 ===
# 從 https://discord.com/developers/applications 取得（Bot → Reset Token）
# 這是 Discord 的 token，不是 vLLM 的 sk-vllm- 金鑰（vLLM 金鑰 bot 會自動讀，不用填）
DISCORD_BOT_TOKEN=貼上你的_bot_token

# === 模型服務：server/vllm 架設的 vLLM（bot 跟 vLLM 跑在同一台）===
# deploy.ps1（Windows 筆電）/ deploy.sh（Ubuntu 伺服器）會自動填好
LLM_BASE_URL=http://127.0.0.1:8000/v1
# 只有 Windows 用：vLLM 所在的 WSL 發行版
WSL_DISTRO=Ubuntu
# 留空 = 自動讀主機的 ~/vllm-server/vllm.env（建議；Ubuntu 直接讀、Windows 從 WSL 讀），換金鑰後 bot 也會自動重讀
# 接遠端 gateway（deploy.sh --remote）時，這裡要填該服務的金鑰
LLM_API_KEY=
# 指定模型名稱：留空 = 自動用 /v1/models 的第一個（本地 vLLM 建議留空）
# 接多模型 gateway（例如 NCHC genai）時，填要用的模型名（可先 curl <網址>/models 查有哪些）
LLM_MODEL=
# 單次請求逾時秒數
LLM_TIMEOUT=600
# 思考模式：auto = 本地 vLLM 關掉思考求快、遠端 gateway（NCHC Kimi 等）保留思考（建議）
#           off = 一律關掉（快但較笨）；on = 一律交給模型預設
LLM_THINKING=auto

# === 工具（function calling + MCP）===
# 1=讓模型自己決定要不要搜尋、讀網址、查維基 / arXiv、計算…；0=關掉，只聊天
# 要用哪些 MCP server 在 mcp_servers.json 設定；Discord 輸入 !tools 看狀態
ENABLE_TOOLS=1
# 用工具時的進度：brief = 一則「查資料中…」訊息，答完自動刪掉；off = 不顯示
TOOL_STATUS=brief
# 一次回答最多呼叫幾輪工具、每個工具結果最多給模型幾個字
MAX_TOOL_ROUNDS=8
TOOL_RESULT_MAX_CHARS=12000
# 擋掉工具存取內網 / 本機網址（避免有人叫 bot 去讀 127.0.0.1 的 vLLM 或實驗室內部服務）
BLOCK_PRIVATE_URLS=1

# 系統提示：決定 bot 的個性與語言
SYSTEM_PROMPT=你是大學研究室的 AI 助理，請用台灣繁體中文回答，內容要正確、簡潔、有條理；不確定的事要說不確定。

# 每個頻道記住的對話則數，以及記憶總字數上限
# （本地 vLLM 上下文小用預設值；deploy.sh --remote 會自動放大成 30 則 / 40000 字）
MAX_HISTORY=10
HISTORY_MAX_CHARS=8000

# 產檔時附件 / 被回覆訊息當參考資料，最多讀幾個字
# （vLLM 上下文 32k 時 10000 字夠用；筆電改用 16k 的 small 組合時建議降到 5000）
REF_MAX_CHARS=10000

# 自動把簡體字轉台灣繁體（1=開、0=關）
TO_TRADITIONAL=1

# 只在這個頻道 ID 回應一般聊天（留空=所有頻道都回；被 @提及、私訊、! 指令一定會回）
ALLOWED_CHANNEL_ID=

# === 文件字型 ===
DOC_FONT_EA=標楷體
DOC_FONT_LATIN=Times New Roman
PPT_FONT=微軟正黑體

# === 聯網搜尋設定 ===
# 用哪個搜尋引擎：google 或 duckduckgo
# 選 google 但沒填下面金鑰時，會自動退回 duckduckgo
SEARCH_ENGINE=google
# Google Custom Search JSON API（免費 100 次/天）
#   API Key：https://console.cloud.google.com/  啟用 "Custom Search API" 後建立金鑰
#   CSE ID ：https://programmablesearchengine.google.com/  建立搜尋引擎，設「搜尋整個網路」
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
