# === Discord Bot 設定 ===
# 從 https://discord.com/developers/applications 取得（Bot → Reset Token）
DISCORD_BOT_TOKEN=貼上你的_bot_token

# === 模型服務（WSL 裡的 llama-swap → vLLM）===
# OpenAI 相容 API 位址；WSL2 的服務在 Windows 用 localhost 就連得到
LLM_BASE_URL=http://127.0.0.1:8080/v1
# 若在 llama-swap.yaml 設了 apiKeys 才需要填
LLM_API_KEY=
# 預設模型 = wsl/llama-swap.yaml 裡 models 的名稱；Discord 可用 !model 切換（會記住）
DEFAULT_MODEL=qwen3-8b
# 單次請求逾時秒數（第一次載入模型可能要數分鐘）
LLM_TIMEOUT=900

# 系統提示：決定 bot 的個性與語言
SYSTEM_PROMPT=你是大學研究室的 AI 助理，請用台灣繁體中文回答，內容要正確、簡潔、有條理；不確定的事要說不確定。

# 每個頻道記住的對話則數，以及記憶總字數上限（8GB 顯卡上下文小，別開太大）
MAX_HISTORY=10
HISTORY_MAX_CHARS=4000

# 產檔時附件 / 被回覆訊息當參考資料，最多讀幾個字（用 qwen3-4b 可調到 8000）
REF_MAX_CHARS=3000

# 自動把簡體字轉台灣繁體（1=開、0=關）
TO_TRADITIONAL=1

# 只在這個頻道 ID 回應一般聊天（留空=所有頻道都回；被 @提及、私訊、! 指令一定會回）
ALLOWED_CHANNEL_ID=

# === 文件字型 ===
DOC_FONT_EA=標楷體
DOC_FONT_LATIN=Times New Roman
PPT_FONT=微軟正黑體

# === 聯網搜尋設定 ===
# 用哪個搜尋引擎：google 或 duckduckgo
# 選 google 但沒填下面金鑰時，會自動退回 duckduckgo
SEARCH_ENGINE=google
# Google Custom Search JSON API（免費 100 次/天）
#   API Key：https://console.cloud.google.com/  啟用 "Custom Search API" 後建立金鑰
#   CSE ID ：https://programmablesearchengine.google.com/  建立搜尋引擎，設「搜尋整個網路」
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
